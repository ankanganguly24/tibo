{
  "name": "@goankan/tibo",
  "version": "0.1.0",
  "description": "Local-first evidence review for coding-agent changes.",
  "type": "module",
  "bin": {
    "tibo": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "codex",
    "ai-coding",
    "cli",
    "developer-tools",
    "local-first"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.5.4",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankanganguly24/tibo.git"
  },
  "homepage": "https://tiborun.vercel.app",
  "bugs": {
    "url": "https://github.com/ankanganguly24/tibo/issues"
  },
  "files": [
    "dist/index.js",
    "dist/detect.js",
    "dist/git.js",
    "dist/ledger.js",
    "dist/summary.js",
    "dist/types.js",
    "README.md",
    "LICENSE",
    "schemas/finding.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
